"line":3,"column":1}},"key":"W9cuHFwkPh"},{"type":"inlineCode","value":"13_perfect_foresight_weather_lightgbm.ipynb","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IL2fzwcCEx"},{"type":"text","value":" — see there for\nthe per-technology / load rationale.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"LHXXZx1tMk"}],"key":"D0B5qtWnFj"}],"key":"euBVjbK7r6"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-17T19:08:56.942816Z","iopub.status.busy":"2026-07-17T19:08:56.942635Z","iopub.status.idle":"2026-07-17T19:08:57.311515Z","shell.execute_reply":"2026-07-17T19:08:57.310672Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"solar_cf = average_across_technologies(pd.read_parquet(paths.pecd_solar_capacity_factors_file))\nnuts2_capacity = pd.read_parquet(paths.mastr_capacity_by_nuts2_month_file)\nsolar_capacity = (\n    nuts2_capacity[nuts2_capacity[\"series\"].str.startswith(\"solar_\")]\n    .groupby([\"region_code\", \"month\"], as_index=False)[\"capacity_mw\"]\n    .sum()\n)\n\nwind_onshore_cf = pd.read_parquet(paths.pecd_wind_onshore_capacity_factors_file)\nwind_onshore_capacity = pd.read_parquet(paths.mastr_capacity_by_peon_month_file)\n\nwind_offshore_cf = pd.read_parquet(paths.pecd_wind_offshore_capacity_factors_file)\nwind_offshore_capacity = pd.read_parquet(paths.mastr_capacity_by_peof_month_file)\n\npv_features = build_weather_capacity_features(solar_cf, solar_capacity, prefix=\"pv\")\nwind_onshore_features = build_weather_capacity_features(wind_onshore_cf, wind_onshore_capacity, prefix=\"wind_onshore\")\nwind_offshore_features = build_weather_capacity_features(wind_offshore_cf, wind_offshore_capacity, prefix=\"wind_offshore\")\ntemperature_features = build_temperature_feature(pd.read_parquet(paths.pecd_temperature_file))\n\nextra_features_by_target = {\n    \"pv\": pv_features,\n    \"wind_onshore\": wind_onshore_features,\n    \"wind_offshore\": wind_offshore_features,\n    \"load\": pd.concat([pv_features, wind_onshore_features, wind_offshore_features, temperature_features], axis=1),\n}","key":"FtwMWbd4XK"},{"type":"outputs","id":"SKvl9Of4ccTflHMJBbFjZ","children":[],"key":"dRcXhYtCkB"}],"key":"IDTo3LTLhR"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Features used","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EiAv1xb4Wd"}],"identifier":"features-used","label":"Features used","html_id":"features-used","implicit":true,"key":"oVjw2S22AV"}],"key":"bY1m5DMBOG"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-17T19:08:57.313393Z","iopub.status.busy":"2026-07-17T19:08:57.313298Z","iopub.status.idle":"2026-07-17T19:08:57.437280Z","shell.execute_reply":"2026-07-17T19:08:57.436548Z"},"lines_to_next_cell":1},"children":[{"type":"code","lang":"python","executable":true,"value":"for target, features in describe_feature_sets(panel, extra_features_by_target).items():\n    print(f\"{target:15s} ({len(features)} features): {', '.join(features)}\")","key":"jAae1H1I69"},{"type":"outputs","id":"v6GdOBiz5pFCsmIUo4ahx","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"pv              (10 features): hour_sin, hour_cos, doy_sin, doy_cos, lag_1h, lag_2h, lag_24h, lag_48h, pv_effective_cf, pv_capacity_mw\nwind_onshore    (10 features): hour_sin, hour_cos, doy_sin, doy_cos, lag_1h, lag_2h, lag_24h, lag_48h, wind_onshore_effective_cf, wind_onshore_capacity_mw\nwind_offshore   (10 features): hour_sin, hour_cos, doy_sin, doy_cos, lag_1h, lag_2h, lag_24h, lag_48h, wind_offshore_effective_cf, wind_offshore_capacity_mw\nload            (23 features): hour_sin, hour_cos, doy_sin, doy_cos, lag_1h, lag_2h, lag_24h, lag_48h, lag_weekday_match, weekday_Tuesday, weekday_Wed