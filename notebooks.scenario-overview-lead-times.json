{"type":"outputs","id":"xEO4eb3Ro6SNDSiDiR7Jb","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"6 scenarios: ['baseline_lightgbm', 'baseline_linear_regression', 'perfect_foresight_weather_catboost_quarterly_refit', 'perfect_foresight_weather_lightgbm', 'perfect_foresight_weather_lightgbm_quarterly_refit', 'perfect_foresight_weather_xgboost_quarterly_refit']\n"},"children":[],"key":"fmdQdoLfu6"}],"key":"oTrTKwA6Rk"}],"key":"ga00vTZgs2"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-17T19:09:52.779061Z","iopub.status.busy":"2026-07-17T19:09:52.778909Z","iopub.status.idle":"2026-07-17T19:09:52.782782Z","shell.execute_reply":"2026-07-17T19:09:52.782160Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def plot_metric_by_horizon(metric: str) -> plt.Figure:\n    fig, axes = plt.subplots(2, 2, figsize=(11, 8))\n    for ax, target in zip(axes.flat, TARGETS):\n        target_metrics = metrics[metrics[\"target\"] == target]\n        for scenario_id, group in target_metrics.groupby(\"scenario_id\"):\n            group = group.sort_values(\"horizon_days\")\n            ax.plot(\n                group[\"horizon_days\"],\n                group[metric],\n                color=scenario_colors[scenario_id],\n                marker=\"o\",\n                linewidth=2,\n                label=scenario_titles[scenario_id],\n                zorder=3,\n            )\n        ax.set_xticks(horizons_days)\n        ax.set_xticklabels([f\"{h}d\" for h in horizons_days])\n        ax.set_title(TARGET_LABELS[target])\n        ax.set_ylabel(f\"Validation {metric.upper()} (MW)\")\n        ax.set_ylim(bottom=0)\n        style_axis(ax)\n\n    handles, labels = axes.flat[0].get_legend_handles_labels()\n    fig.legend(handles, labels, loc=\"upper center\", ncol=len(scenario_colors), bbox_to_anchor=(0.5, 1.04), frameon=False)\n    fig.tight_layout()\n    return fig","key":"FxrZRbk6EC"},{"type":"outputs","id":"vM-QQBk5f2KfiPaKooq5i","children":[],"key":"RwNWTCmhVH"}],"key":"gPcQGYszPq"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"MAE by lead time","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oG43pL8OZV"}],"identifier":"mae-by-lead-time","label":"MAE by lead time","html_id":"mae-by-lead-time","implicit":true,"key":"yLzZDUWe8O"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/delu-headline-forecast/build/07_lead_time_mae-d26c9d42e08f034fe417b4e833473c0c.png","alt":"Validation MAE vs. forecast horizon, one line per scenario.","data":{"altTextIsAutoGenerated":true},"key":"ONpVV9O9nr","urlSource":"../../output/images/07_lead_time_mae.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"fig-07-lead-time-mae","identifier":"fig-07-lead-time-mae","html_id":"fig-07-lead-time-mae","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"hptlAumcFx"},{"type":"text","value":"1","key":"lhA08SJKE7"},{"type":"text","value":":","key":"pZyefvQ7kf"}],"template":"Figure %s:","key":"K25TS97orB"},{"type":"text","value":"Validation MAE vs. forecast horizon, one line per scenario.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"WfizUwTCyo"}],"key":"Dx6DKlnAXc"}],"key":"y4Bl0V89SX"}],"label":"fig-07-lead-time-mae","identifier":"fig-07-lead-time-mae","enumerator":"1","html_id":"fig-07-lead-time-mae","key":"JU8zsfwU2u"}],"key":"PsMaDfRHQu"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-17T19:09:52.783950Z","iopub.status.busy":"2026-07-17T19:09:52.783858Z","iopub.status.idle":"2026-07-17T19:09:53.254635Z","shell.execute_reply":"2026-07-17T19:09:53.253970Z"}},"child