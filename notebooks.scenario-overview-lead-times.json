{"type":"outputs","id":"5XawPVkM98YLm-ug49n7w","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"6 scenarios: ['baseline_lightgbm', 'baseline_linear_regression', 'perfect_foresight_weather_catboost_quarterly_refit', 'perfect_foresight_weather_lightgbm', 'perfect_foresight_weather_lightgbm_quarterly_refit', 'perfect_foresight_weather_xgboost_quarterly_refit']\n"},"children":[],"key":"X0qUEeSps6"}],"key":"tGQ017cO3Y"}],"key":"KFjKxiFqO6"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-17T19:09:52.779061Z","iopub.status.busy":"2026-07-17T19:09:52.778909Z","iopub.status.idle":"2026-07-17T19:09:52.782782Z","shell.execute_reply":"2026-07-17T19:09:52.782160Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def plot_metric_by_horizon(metric: str) -> plt.Figure:\n    fig, axes = plt.subplots(2, 2, figsize=(11, 8))\n    for ax, target in zip(axes.flat, TARGETS):\n        target_metrics = metrics[metrics[\"target\"] == target]\n        for scenario_id, group in target_metrics.groupby(\"scenario_id\"):\n            group = group.sort_values(\"horizon_days\")\n            ax.plot(\n                group[\"horizon_days\"],\n                group[metric],\n                color=scenario_colors[scenario_id],\n                marker=\"o\",\n                linewidth=2,\n                label=scenario_titles[scenario_id],\n                zorder=3,\n            )\n        ax.set_xticks(horizons_days)\n        ax.set_xticklabels([f\"{h}d\" for h in horizons_days])\n        ax.set_title(TARGET_LABELS[target])\n        ax.set_ylabel(f\"Validation {metric.upper()} (MW)\")\n        ax.set_ylim(bottom=0)\n        style_axis(ax)\n\n    handles, labels = axes.flat[0].get_legend_handles_labels()\n    fig.legend(handles, labels, loc=\"upper center\", ncol=len(scenario_colors), bbox_to_anchor=(0.5, 1.04), frameon=False)\n    fig.tight_layout()\n    return fig","key":"A8aC1Xz63e"},{"type