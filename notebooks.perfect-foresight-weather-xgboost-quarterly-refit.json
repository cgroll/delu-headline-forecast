":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-17T19:08:09.304581Z","iopub.status.busy":"2026-07-17T19:08:09.304330Z","iopub.status.idle":"2026-07-17T19:08:10.696355Z","shell.execute_reply":"2026-07-17T19:08:10.695913Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import pandas as pd\nfrom xgboost import XGBRegressor\n\nfrom dhf.paths import ProjPaths\nfrom dhf.pecd import average_across_technologies, build_temperature_feature, build_weather_capacity_features\nfrom dhf.reporting import (\n    describe_feature_sets,\n    fit_and_evaluate_walkforward,\n    plot_actual_vs_predicted,\n    plot_importance_heatmaps,\n    plot_mae_by_horizon,\n    plot_rolling_error,\n    plot_scatter_actual_vs_predicted,\n)\nfrom dhf.scenarios import save_scenario_metrics\nfrom dhf.splits import EXAMPLE_WINDOWS\nfrom dhf.viz import KNOWN_SCENARIO_COLORS, MODEL_LABELS\n\npaths = ProjPaths()\npaths.ensure_directories()\n\nSCENARIO_ID = \"perfect_foresight_weather_xgboost_quarterly_refit\"\nCOLOR = KNOWN_SCENARIO_COLORS[SCENARIO_ID]\nMODEL_LABEL = MODEL_LABELS[\"xgboost\"]\n\npanel = pd.read_parquet(paths.target_panel_file)","key":"O5BrFgMJfi"},{"type":"outputs","id":"tthuu6jBqw97kfsbKsmLx","children":[],"key":"dWZcNN0Rs1"}],"key":"IvJTfJs9pi"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the weather + capacity features","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YpfQvJ6vAq"}],"identifier":"build-the-weather-capacity-features","label":"Build the weather + capacity features","html_id":"build-the-weather-capacity-features","implicit":true,"key":"h1WvSWxr1E"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Identical to ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hvoj6O7NaE"},{"type":"inlineCode","value":"13_perfect_foresight_weather_lightgbm.ipynb","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zlQRiWlo2Q"},{"type":"text","value":" — see there for\nthe per-technology / load rationale.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SeUPPaqHQJ"}],"key":"V38TkeWUS8"}],"key":"hur95NaF95"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-17T19:08:10.698333Z","iopub.status.busy":"2026-07-17T19:08:10.698110Z","iopub.status.idle":"2026-07-17T19:08:11.064238Z","shell.execute_reply":"2026-07-17T19:08:11.063560Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"solar_cf = average_across_technologies(pd.read_parquet(paths.pecd_solar_capacity_factors_file))\nnuts2_capacity = pd.read_parquet(paths.mastr_capacity_by_nuts2_month_file)\nsolar_capacity = (\n    nuts2_capacity[nuts2_capacity[\"series\"].str.startswith(\"solar_\")]\n    .groupby([\"region_code\", \"month\"], as_index=False)[\"capacity_mw\"]\n    .sum()\n)\n\nwind_onshore_cf = pd.read_parquet(paths.pecd_wind_onshore_capacity_factors_file)\nwind_onshore_capacity = pd.read_parquet(paths.mastr_capacity_by_peon_month_file)\n\nwind_offshore_cf = pd.read_parquet(paths.pecd_wind_offshore_capacity_factors_file)\nwind_offshore_capacity = pd.read_parquet(paths.mastr_capacity_by_peof_month_file)\n\npv_features = build_weather_capacity_features(solar_cf, solar_capacity, prefix=\"pv\")\nwind_onshore_features = build_weather_capacity_features(wind_onshore_cf, wind_onshore_capacity, prefix=\"wind_onshore\")\nwind_offshore_features = build_weather_capacity_features(wind_offshore_cf, wind_offshore_capacity, prefix=\"wind_offshore\")\ntemperature_features = build_temperature_feature(pd.read_parquet(paths.pecd_temperature_file))\n\nextra_features_by_target = {\n    \"pv\": pv_features,\n    \"wind_onshore\": wind_onshore_features,\n    \"wind_offshore\": wind_offshore_features,\n    \"load\": pd.concat([pv_features, wind_onshore_features, wind_offshore_features, temperature_features], axis=1),\n}","key":"zzPNHvSWwJ"},{"type":"outputs","id":"GdxO6aEQ7G_t1eruYppxr","children":[],"key":"FyIVd03i97"}],"key":"vjsoARi8HM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Features used","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"n4fbNPew2X"}],"identifier":"features-used","label":"Features used","html_id":"features-used","implicit":true,"key":"ixKgNNrgFs"}],"key":"QVZIxXtW7N"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-17T19:08:11.066063Z","iopub.status.busy":"2026-07-17T19:08:11.065881Z","iopub.status.idle":"2026-07-17T19:08:11.198137Z","shell.execute_reply":"2026-07-17T19:08:11.197547Z"},"lines_to_next_cell":1},"children":[{"type":"code","lang":"python","executable":true,"value":"for target, features in describe_feature_sets(panel, extra_features_by_target).items():\n    print(f\"{target:15s} ({len(features)} features): {', '.join(features)}\")","key":"nvImiWyNvs"},{"type":"outputs","id":"Rr0M6yg5_DFGQPDx5v-s0","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"pv              (10 features): hour_sin, hour_cos, doy_sin, doy_cos, lag_1h, lag_2h, lag_24h, lag_48h, pv_effective_cf, pv_capacity_mw\nwind_onshore    (10 features): hour_sin, hour_cos, doy_sin, doy_cos, lag_1h, lag_2h, lag_24h, lag_48h, wind_onshore_effective_cf, wind_onshore_capacity_mw\nwind_offshore   (10 features): hour_sin, hour_cos, doy_sin, doy_cos, lag_1h, lag_2h, lag_24h, lag_48h, wind_offshore_effective_cf, wind_offshore_capacity_mw\nload            (23 features): hour_sin, hour_cos, doy_sin, doy_cos, lag_1h, lag_2h, lag_24h, lag_48h, lag_weekday_match, weekday_Tuesday, weekday_Wednesday, weekday_T