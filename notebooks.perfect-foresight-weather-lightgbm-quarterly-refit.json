value":"Motivation: ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"AhGtTUVJxB"},{"type":"inlineCode","value":"13_perfect_foresight_weather_lightgbm.ipynb","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"OdLxVtlMAr"},{"type":"text","value":"’s scatter plot\nshowed a hard ceiling in offshore wind predictions — LightGBM (a\ntree-based model) can’t predict beyond the range of target values it saw\nduring training, and offshore capacity nearly tripled over the data’s\nhistory, so a model trained once on a stale multi-year window\nsystematically under-predicts once the fleet grows past what training\never saw. Periodic refitting keeps the training window’s upper end closer\nto “now,” which should shrink (not necessarily eliminate — see\ndocs/modeling_plan.md’s note on the target-rescaling alternative, not\napplied here) that gap.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"tN4eYJhJen"}],"key":"qNT7k2ElLj"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"This is a ","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"RI7YT3PsxB"},{"type":"strong","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"refit-schedule-only","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"QpDvPAwg6N"}],"key":"NSY2zAQBbD"},{"type":"text","value":" change relative to\n","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"ihCo5ioyW3"},{"type":"inlineCode","value":"13_perfect_foresight_weather_lightgbm.ipynb","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"mMt9hUjSOG"},{"type":"text","value":" — the target is still\nabsolute MW, not a capacity-factor ratio (that’s a separate, not-yet-tried\nlever, deliberately not combined with this one so the two can’t be\nconfused — see docs/modeling_plan.md’s “one delta at a time” convention).","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"NsJS3kJxhA"}],"key":"lZRQ3C8dTA"}],"key":"fkI8zV4DOG"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-17T19:07:44.351165Z","iopub.status.busy":"2026-07-17T19:07:44.351074Z","iopub.status.idle":"2026-07-17T19:07:45.720440Z","shell.execute_reply":"2026-07-17T19:07:45.719929Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import pandas as pd\nfrom lightgbm import LGBMRegressor\n\nfrom dhf.paths import ProjPaths\nfrom dhf.pecd import average_across_technologies, build_temperature_feature, build_weather_capacity_features\nfrom dhf.reporting import (\n    describe_feature_sets,\n    fit_and_evaluate_walkforward,\n    plot_actual_vs_predicted,\n    plot_importance_heatmaps,\n    plot_mae_by_horizon,\n    plot_rolling_error,\n    plot_scatter_actual_vs_predicted,\n)\nfrom dhf.scenarios import save_scenario_metrics\nfrom dhf.splits import EXAMPLE_WINDOWS\nfrom dhf.viz import KNOWN_SCENARIO_COLORS, MODEL_LABELS\n\npaths = ProjPaths()\npaths.ensure_directories()\n\nSCENARIO_ID = \"perfect_foresight_weather_lightgbm_quarterly_refit\"\nCOLOR = KNOWN_SCENARIO_COLORS[SCENARIO_ID]\nMODEL_LABEL = MODEL_LABELS[\"lightgbm\"]\n\npanel = pd.read_parquet(paths.target_panel_file)","key":"sJsRJsT6rA"},{"type":"outputs","id":"8PJgWiisvW5wQO90yuip_","children":[],"key":"pLeQBDRBgI"}],"key":"hF6HD6z5eS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the weather + capacity features","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TuutD5sDSc"}],"identifier":"build-the-weather-capacity-features","label":"Build the weather + capacity features","html_id":"build-the-weather-capacity-features","implicit":true,"key":"or47YbfLPA"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Identical to ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"p986gXwx7N"},{"type":"inlineCode","value":"13_perfect_foresight_weather_lightgbm.ipynb","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"d0ZFAwTAvK"},{"type":"text","value":" — see there for\nthe per-technology / load rationale.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JL9jwRmn56"}],"key":"dq2ypW8Shw"}],"key":"zztCG1Hzlv"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-17T19:07:45.721812Z","iopub.status.busy":"2026-07-17T19:07:45.721623Z","iopub.status.idle":"2026-07-17T19:07:46.092116Z","shell.execute_reply":"2026-07-17T19:07:46.091631Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"solar_cf = average_across_technologies(pd.read_parquet(paths.pecd_solar_capacity_factors_file))\nnuts2_capacity = pd.read_parquet(paths.mastr_capacity_by_nuts2_month_file)\nsolar_capacity = (\n    nuts2_capacity[nuts2_capacity[\"series\"].str.startswith(\"solar_\")]\n    .groupby([\"region_code\", \"month\"], as_index=False)[\"capacity_mw\"]\n    .sum()\n)\n\nwind_onshore_cf = pd.read_parquet(paths.pecd_wind_onshore_capacity_factors_file)\nwind_onshore_capacity = pd.read_parquet(paths.mastr_capacity_by_peon_month_file)\n\nwind_offshore_cf = pd.read_parquet(paths.pecd_wind_offshore_capacity_factors_file)\nwind_offshore_capacity = pd.read_parquet(paths.mastr_capacity_by_peof_month_file)\n\npv_features = build_weather_capacity_features(solar_cf, solar_capacity, prefix=\"pv\")\nwind_onshore_features = build_weather_capacity_features(wind_onshore_cf, wind_onshore_capacity, prefix=\"wind_onshore\")\nwind_offshore_features = build_weather_capacity_features(wind_offshore_cf, wind_offshore_capacity, prefix=\"wind_offshore\")\ntemperature_features = build_temperature_feature(pd.read_parquet(paths.pecd_temperature_file))\n\nextra_features_by_target = {\n    \"pv\": pv_features,\n    \"wind_onshore\": wind_onshore_features,\n    \"wind_offshore\": wind_offshore_features,\n    \"load\": pd.concat([pv_features, wind_onshore_features, wind_offshore_features, temperature_features], axis=1),\n}","key":"M8AFO4TE3I"},{"type":"outputs","id":"nGEwpUpwaxZxgOkC7JnNn","children":[],"key":"AW2ThBd8Qv"}],"key":"gVt64yNgfI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Features used","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mFWl4dPxBa"}],"identifier":"features-used","label":"Features used","html_id":"features-used","implicit":true,"key":"AKJQ0gejnZ"}],"key":"fv4emrqa32"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-17T19:07:46.094021Z","iopub.status.busy":"2026-07-17T19:07:46.093928Z","iopub.status.idle":"2026-07-17T19:07:46.225822Z","shell.execute_reply":"2026-07-17T19:07:46.225398Z"},"lines_to_next_cell":1},"children":[{"type":"code","lang":"python","executable":true,"value":"for target, features in describe_feature_sets(panel, extra_features_by_target).items():\n    print(f\"{target:15s} ({len(features)} features): {', '.join(features)}\")","key":"I6mBiw8rxZ"},{"type":"outputs","id":"8oLC2qEN4usGroa581UkV","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"pv              (10 features): hour_sin, hour_cos, doy_sin, doy_cos, lag_1h, lag_2h, lag_24h, lag_48h, pv_effective_cf, pv_capacity_mw\nwind_onshore    (10 features): hour_sin, hour_cos, doy_sin, doy_cos, lag_1h, lag_2h, lag_24h, lag_48h, wind_onshore_effective_cf, wind_onshore_capacity_mw\nwind_offshore   (10 features): hour_sin, hour_cos, doy_sin, doy_cos, lag_1h, 