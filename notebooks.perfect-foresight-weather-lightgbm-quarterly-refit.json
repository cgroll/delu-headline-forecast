value":"Motivation: ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"Qf2kpjwIB5"},{"type":"inlineCode","value":"13_perfect_foresight_weather_lightgbm.ipynb","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"mAVWVrbfKn"},{"type":"text","value":"’s scatter plot\nshowed a hard ceiling in offshore wind predictions — LightGBM (a\ntree-based model) can’t predict beyond the range of target values it saw\nduring training, and offshore capacity nearly tripled over the data’s\nhistory, so a model trained once on a stale multi-year window\nsystematically under-predicts once the fleet grows past what training\never saw. Periodic refitting keeps the training window’s upper end closer\nto “now,” which should shrink (not necessarily eliminate — see\ndocs/modeling_plan.md’s note on the target-rescaling alternative, not\napplied here) that gap.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"NPdV9fK21J"}],"key":"SLQbwPzqhl"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"This is a ","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"KKXM9RDTO7"},{"type":"strong","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"refit-schedule-only","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"feToNS5bM5"}],"key":"cZMtVmJd7s"},{"type":"text","value":" change relative to\n","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"uAZLbKW7g8"},{"type":"inlineCode","value":"13_perfect_foresight_weather_lightgbm.ipynb","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"gRTFdjhD6y"},{"type":"text","value":" — the target is still\nabsolute MW, not a capacity-factor ratio (that’s a separate, not-yet-tried\nlever, deliberately not combined with this one so the two can’t be\nconfused — see docs/modeling_plan.md’s “one delta at a time” convention).","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"sRrmXDpXcz"}],"key":"RGKPOIHPws"}],"key":"NBG7KiRuew"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-17T19:07:44.351165Z","iopub.status.busy":"2026-07-17T19:07:44.351074Z","iopub.status.idle":"2026-07-17T19:07:45.720440Z","shell.execute_reply":"2026-07-17T19:07:45.719929Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import pandas as pd\nfrom lightgbm import LGBMRegressor\n\nfrom dhf.paths import ProjPaths\nfrom dhf.pecd import average_across_technologies, build_temperature_feature, build_weather_capacity_features\nfrom dhf.reporting import (\n    describe_feature_sets,\n    fit_and_evaluate_walkforward,\n    plot_actual_vs_predicted,\n    plot_importance_heatmaps,\n    plot_mae_by_horizon,\n    plot_rolling_error,\n    plot_scatter_actual_vs_predicted,\n)\nfrom dhf.scenarios import save_scenario_metrics\nfrom dhf.splits import EXAMPLE_WINDOWS\nfrom dhf.viz import KNOWN_SCENARIO_COLORS, MODEL_LABELS\n\npaths = ProjPaths()\npaths.ensure_directories()\n\nSCENARIO_ID = \"perfect_foresight_weather_lightgbm_quarterly_refit\"\nCOLOR = KNOWN_SCENARIO_COLORS[SCENARIO_ID]\nMODEL_LABEL = MODEL_LABELS[\"lightgbm\"]\n\npanel = pd.read_parquet(paths.target_panel_file)","key":"qejI66vmKu"},{"type":"outputs","id":"ZIS-YiEa403UeAz1VtZR5","children":[],"key":"L2CiCv4wxz"}],"key":"aX8PEk9fg8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Build the weather + capacity features","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CYJf60M908"}],"identifier":"build-the-weather-capacity-features","label":"Build the weather + capacity features","html_id":"build-the-weather-capacity-features","implicit":true,"key":"BWzN5a4cE9"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Identical to ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aPgbUx5ewR"},{"type":"inlineCode","value":"13_perfect_foresight_weather_lightgbm.ipynb","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WKvu2Cf1jA"},{"type":"text","value":" — see there for\nthe per-technology / load rationale.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EJZ9cTGJdE"}],"key":"Vx45VPIeYn"}],"key":"zaRymRBOfs"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-17T19:07:45.721812Z","iopub.status.busy":"2026-07-17T19:07:45.721623Z","iopub.status.idle":"2026-07-17T19:07:46.092116Z","shell.execute_reply":"2026-07-17T19:07:46.091631Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"solar_cf = average_across_technologies(pd.read_parquet(paths.pecd_solar_capacity_factors_file))\nnuts2_capacity = pd.read_parquet(paths.mastr_capacity_by_nuts2_month_file)\nsolar_capacity = (\n    nuts2_capacity[nuts2_capacity[\"series\"].str.startswith(\"solar_\")]\n    .groupby([\"region_code\", \"month\"], as_index=False)[\"capacity_mw\"]\n    .sum()\n)\n\nwind_onshore_cf = pd.read_parquet(paths.pecd_wind_onshore_capacity_factors_file)\nwind_onshore_capacity = pd.read_parquet(paths.mastr_capacity_by_peon_month_file)\n\nwind_offshore_cf = pd.read_parquet(paths.pecd_wind_offshore_capacity_factors_file)\nwind_offshore_capacity = pd.read_parquet(paths.mastr_capacity_by_peof_month_file)\n\npv_features = build_weather_capacity_features(solar_cf, solar_capacity, prefix=\"pv\")\nwind_onshore_features = build_weather_capacity_features(wind_onshore_cf, wind_onshore_capacity, prefix=\"wind_onshore\")\nwind_offshore_features = build_weather_capacity_features(wind_offshore_cf, wind_offshore_capacity, prefix=\"wind_offshore\")\ntemperature_features = build_temperature_feature(pd.read_parquet(paths.pecd_temperature_file))\n\nextra_features_by_target = {\n    \"pv\": pv_features,\n    \"wind_onshore\": wind_onshore_features,\n    \"wind_offshore\": wind_offshore_features,\n    \"load\": pd.concat([pv_features, wind_onshore_features, wind_offshore_features, temperature_features], axis=1),\n}","key":"ggG7xCtHlH"},{"type":"outputs","id":"bRQAEQWTot-0UKWdrCuvc","children":[],"key":"CJhJXnveNb"}],"key":"MGLeTWU7Br"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Features used","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YV0TpYUUa9"}],"identifier":"features-used","label":"Features used","html_id":"features-used","implicit":true,"key":"ZNlEXJ8zxC"}],"key":"QbdzJH6ijR"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-17T19:07:46.094021Z","iopub.status.busy":"2026-07-17T19:07:46.093928Z","iopub.status.idle":"2026-07-17T19:07:46.225822Z","shell.execute_reply":"2026-07-17T19:07:46.225398Z"},"lines_to_next_cell":1},"children":[{"type":"code","lang":"python","executable":true,"value":"for target, features in describe_feature_sets(panel, extra_features_by_target).items():\n    print(f\"{target:15s} ({len(features)} features): {', '.join(features)}\")","key":"kEqXJJLsFs"},{"type":"outputs","id":"cCvemvenUFOcp3DipBpag","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"pv              (10 features): hour_sin, hour_cos, doy_sin, doy_cos, lag_1h, lag_2h, lag_24h, lag_48h, pv_effective_cf, pv_capacity_mw\nwind_onshore    (10 features): hour_sin, hour_cos, doy_sin, doy_cos, lag_1h, lag_2h, lag_24h, lag_48h, wind_onshore_effective_cf, wind_onshore_capacity_mw\nwind_offshore   (10 features): hour_sin, hour_cos, doy_sin, doy_cos, lag_1h, 